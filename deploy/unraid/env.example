# Pretty Please Print on Unraid — the stack's ENV file.
#
# In Compose Manager: Edit Stack -> ENV File, paste this in, fill it out.
# It is both the stack's variables and the containers' environment, so every
# secret lives in exactly one place. Walkthrough: docs/unraid.md.
#
# Generate the three secrets in the Unraid terminal:
#   openssl rand -base64 32     (BETTER_AUTH_SECRET, CRON_SECRET)
#   openssl rand -hex 24        (DB_PASSWORD)

# --- secrets ---
BETTER_AUTH_SECRET="CHANGE-ME"
# Baked into the database on first start. Changing it later does NOT change
# the database's password; keep this file with your backups.
DB_PASSWORD="CHANGE-ME"
# The sync (deploy/unraid/sync.sh) reads it from inside the container, so it
# never has to be written anywhere else.
CRON_SECRET="CHANGE-ME"

# --- which images ---
# Published by your fork's "Release images" workflow on every push to main.
# Pin PPP_TAG to a 7-character commit SHA once it's running: that is how you
# update deliberately, and how you roll back (put the old SHA back).
PPP_REGISTRY="ghcr.io/obsidiandesign"
PPP_TAG="latest"

# --- where it lives ---
# The https:// address people use, exactly. SWAG terminates TLS for it.
APP_URL="https://print.example.org"
# The same hostname with no scheme. Passkeys are bound to it PERMANENTLY:
# change it later and every enrolled passkey stops working.
PASSKEY_RP_ID="print.example.org"
PASSKEY_RP_NAME="Pretty Please Print"

# The database, on disk. Use a pool path (/mnt/cache/...) or an appdata share
# set to "Exclusive access"; Postgres is happier off the /mnt/user FUSE layer.
DATA_ROOT="/mnt/cache/appdata/pretty-please-print"

# SWAG's Docker network. It must already exist and SWAG must be on it.
PPP_PROXY_NETWORK="proxynet"

# --- the one admin ---
# No password here on purpose: on first start, `docker logs ppp-migrate` prints
# a one-use link to choose a username and password. Open it within 30 minutes.
ADMIN_EMAIL="you@example.org"
ADMIN_NAME="Your Name"

# --- Bambuddy ---
# LAN address. The containers reach the LAN as-is.
BAMBUDDY_URL="http://10.0.50.216:8000"
# A dedicated Bambuddy account's key with Manage Library + Manage Queue ONLY.
BAMBUDDY_API_KEY="CHANGE-ME"
# Settings -> Slicer Pipelines in Bambuddy. Must be the PLA pipeline.
BAMBUDDY_PIPELINE_ID="1"

# --- client addresses in the audit trail ---
# Leave this false behind SWAG. SWAG's proxy.conf *appends* to
# X-Forwarded-For, so the left-most entry (what "true" reads) is whatever the
# client sent. false means the audit trail records no address, which is honest.
TRUST_PROXY_HEADERS=false

# --- mail (optional) ---
# Without it, invitation and reset links are shown to you on screen to hand
# over. To send them instead, set one of:
# SMTP_URL="smtp://user:pass@smtp.example.org:587"
# RESEND_API_KEY=""
MAIL_FROM="Pretty Please Print <printer@example.org>"

# --- password breach check ---
# Fails closed. Set true only if the server has no outbound internet.
HIBP_DISABLED=false

# --- AGPL source offer ---
# You're running modified code, so the footer's Source link must point at it.
SOURCE_URL="https://github.com/obsidiandesign/prettypleaseprint"
